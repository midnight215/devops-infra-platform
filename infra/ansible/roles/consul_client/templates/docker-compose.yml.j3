version: "3.8"

services:
  consul:
    image: hashicorp/consul:1.16
    container_name: consul
    network_mode: host
    restart: always
    volumes:
      - /opt/consul/data:/consul/data
      - /opt/consul/config:/consul/config
    command: >
      agent
      -node={{ inventory_hostname }}
      -bind={{ private_ip }}
      -advertise={{ private_ip }}
      -client=0.0.0.0
      -data-dir=/consul/data
      -config-dir=/consul/config
{% for host in groups['consul'] %}
      -retry-join={{ hostvars[host].private_ip }}
{% endfor %}

