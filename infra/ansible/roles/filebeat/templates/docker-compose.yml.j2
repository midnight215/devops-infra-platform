version: "3.8"

services:
  filebeat:
    image: elastic/filebeat:7.17.18
    container_name: filebeat
    user: root
    volumes:
      - /var/log:/var/log:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - ./filebeat.yml:/usr/share/filebeat/filebeat.yml:ro
    command: ["--strict.perms=false"]

