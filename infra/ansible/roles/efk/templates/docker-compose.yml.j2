services:
  elasticsearch:
    image: docker.elastic.co/elasticsearch/elasticsearch:7.17.18
    container_name: elasticsearch
    environment:
      - node.name=es-node1
      - cluster.name=efk-cluster
      - discovery.type=single-node
      - bootstrap.memory_lock=true
      - ES_JAVA_OPTS=-Xms1g -Xmx1g
    ulimits:
      memlock:
        soft: -1
        hard: -1
    volumes:
      - ./esdata:/usr/share/elasticsearch/data
    ports:
      - "9200:9200"
      - "9300:9300"
    restart: always

  kibana:
    image: docker.elastic.co/kibana/kibana:7.17.18
    container_name: kibana
    environment:
      ELASTICSEARCH_HOSTS: "http://elasticsearch:9200"
    ports:
      - "5601:5601"
    depends_on:
      - elasticsearch
    restart: always

  curator:
    image: untergeek/curator:5.8.4
    container_name: curator
    volumes:
      - ./curator.yml:/curator/config.yml
      - ./actions.yml:/curator/actions.yml
    depends_on:
      - elasticsearch
    command:
      - --config
      - /curator/config.yml
      - /curator/actions.yml
    restart: "no"

